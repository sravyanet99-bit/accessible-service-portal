{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "Provider": "File",
    "FilePath": "App_Data/service-requests.json",
    "SeedSampleData": true
  },
  "RateLimiting": {
    "SubmissionPermitLimit": 10,
    "SubmissionWindowSeconds": 60
  }
}
